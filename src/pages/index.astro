---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { company, services, partners, whatsapp, url } from '../data/site';
import trio from '../assets/photos/realdew-trio.jpg';
import serumCream from '../assets/photos/realdew-serum-cream.jpg';
import boxes from '../assets/photos/realdew-boxes.jpg';
import binoculars from '../assets/photos/atmos-binoculars.jpg';
import typewriter from '../assets/photos/atmos-typewriter.jpg';

const procurement = services.find((s) => s.sequence)!;
const entry = services.filter((s) => !s.sequence);
const entryArt = [serumCream, typewriter, binoculars];
const posts = (await getCollection('insights')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={company.name} description="KNS Uncles helps Korean beauty and healthcare companies enter GCC, Levant and North African markets, from market fit to signed distribution.">
  <div class="band" aria-labelledby="hero-title">
    <Image src={trio} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" style="object-position: 50% 70%;" />
    <div class="band-text">
      <div class="inner">
        <h1 id="hero-title">Korean beauty and healthcare, delivered to Middle East buyers</h1>
        <p>Market entry, partnerships and sourcing, run from Seoul.</p>
      </div>
    </div>
  </div>

  <div class="wrap over">
    <div class="cards">
      <section class="card" aria-labelledby="c1">
        <h2 id="c1">Take your brand to the region</h2>
        <ul class="quad">
          {entry.map((s, i) => (
            <li><a href={url(`/services/${s.slug}/`)}><Image src={entryArt[i]} alt="" widths={[240]} sizes="8rem" />{s.title}</a></li>
          ))}
          <li><a href={url('/partners/')}><Image src={boxes} alt="" widths={[240]} sizes="8rem" />Our partners</a></li>
        </ul>
        <a class="more" href={url('/services/')}>See all services</a>
      </section>

      <section class="card" aria-labelledby="c2">
        <h2 id="c2">Source Korean medicines</h2>
        <div class="pic"><Image src={boxes} alt="" widths={[400, 700]} sizes="20rem" style="object-position: 50% 45%;" /></div>
        <p>{procurement.summary}</p>
        <a class="more" href={url(`/services/${procurement.slug}/`)}>See how procurement works</a>
      </section>

      <section class="card" aria-labelledby="c3">
        <h2 id="c3">{partners.length} partners on the ground</h2>
        <div class="pic"><Image src={binoculars} alt="" widths={[400, 700]} sizes="20rem" /></div>
        <p>Distributors and pharma groups who tell us what will sell before we bring it.</p>
        <a class="more" href={url('/partners/')}>Meet the partners</a>
      </section>

      <section class="card" aria-labelledby="c4">
        <h2 id="c4">Have a product in mind?</h2>
        <p>Tell us the product, the target country and the timeline. We reply with specifics.</p>
        <div class="actions" style="flex-direction: column; margin-top: 0.25rem;">
          <a class="btn btn-primary" href={url('/contact/')}>Start a project</a>
          <a class="btn" href={whatsapp.href}>Message on WhatsApp</a>
        </div>
        <p style="margin-top: 1rem;">Or email <a href={`mailto:${company.email}`}>{company.email}</a></p>
        <div class="pic" style="margin-top: auto; aspect-ratio: 16 / 9;"><Image src={serumCream} alt="" widths={[400, 700]} sizes="20rem" /></div>
      </section>
    </div>

    <section class="strip" aria-labelledby="partners-title">
      <div class="strip-head"><h2 id="partners-title">Partners in the region</h2><a href={url('/partners/')}>See all</a></div>
      <ul>
        {partners.map((name) => <li><a class="chip" href={url('/partners/')}>{name}</a></li>)}
      </ul>
    </section>

    <section class="detail" aria-labelledby="proc-title">
      <div class="pic"><Image src={boxes} alt="Real Dew boxes, a Korean line sourced through us" widths={[500, 900]} sizes="(min-width: 60rem) 24rem, 100vw" /></div>
      <div>
        <h2 id="proc-title">{procurement.title}: Korean medicines for Middle East pharma companies</h2>
        <p class="byline">by <a href={url('/about/')}>KNS Uncles</a>, Seoul</p>
        <hr />
        <p><strong>How it works</strong></p>
        <ol class="steps-list">
          {procurement.points.map((p) => <li>{p}</li>)}
        </ol>
        <hr />
        <p class="muted" style="font-size: 0.875rem;">We act as your liaison office in Korea, from the first inquiry to production and management.</p>
      </div>
      <aside class="box" aria-label="Start a procurement project">
        <p class="big">Korea liaison office</p>
        <p class="ok">Open to new projects</p>
        <p>Based in Seoul. Working with buyers across the GCC, the Levant and North Africa.</p>
        <div class="actions">
          <a class="btn btn-primary" href={url('/contact/')}>Start a project</a>
          <a class="btn btn-secondary" href={whatsapp.href}>Message on WhatsApp</a>
        </div>
        <dl>
          <dt>Email</dt><dd>{company.email}</dd>
          <dt>WhatsApp</dt><dd>{whatsapp.label}</dd>
        </dl>
      </aside>
    </section>

    <section class="strip" aria-labelledby="notes-title">
      <div class="strip-head"><h2 id="notes-title">Notes from the field</h2><a href={url('/insights/')}>See all notes</a></div>
      <div class="cards">
        {posts.map((post) => (
          <article>
            <h3 style="font-size: 1rem; margin-bottom: 0.25rem;"><a href={url(`/insights/${post.id}/`)}>{post.data.title}</a></h3>
            <p class="meta">{fmt(post.data.pubDate)}{post.data.market && `, ${post.data.market}`}</p>
            <p style="font-size: 0.875rem;">{post.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>
