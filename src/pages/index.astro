---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { company, services, partners, url } from '../data/site';
import trio from '../assets/photos/realdew-trio.jpg';
import serumCream from '../assets/photos/realdew-serum-cream.jpg';
import boxes from '../assets/photos/realdew-boxes.jpg';
import binoculars from '../assets/photos/atmos-binoculars.jpg';
import typewriter from '../assets/photos/atmos-typewriter.jpg';

const serviceArt = { 'market-entry': serumCream, 'deal-structuring': typewriter, execution: binoculars, procurement: boxes } as const;
const procurement = services.find((s) => s.sequence)!;
const stepArt = [typewriter, trio, binoculars, boxes];
const posts = (await getCollection('insights')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const postArt = [typewriter, serumCream];
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---
<Base title={company.name} description="KNS Uncles helps Korean beauty and healthcare companies enter GCC, Levant and North African markets, from market fit to signed distribution.">
  <section class="billboard" aria-labelledby="hero-title">
    <Image src={boxes} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" style="object-position: 50% 56%;" />
    <div class="billboard-info">
      <p class="kicker"><b>KNS</b> Business development</p>
      <h1 id="hero-title">Korean beauty, carried further</h1>
      <div class="billboard-meta">
        <span class="match">13+ years abroad</span>
        <span class="tag">GCC</span><span class="tag">Levant</span><span class="tag">North Africa</span>
        <span>{partners.length} partners</span>
      </div>
      <p>We take Korean beauty and healthcare companies into Middle East markets, and give buyers there a direct line to Korean makers.</p>
      <div class="actions">
        <a class="btn btn-primary" href={url('/contact/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 4.5v15l12-7.5z" /></svg>
          Start a project
        </a>
        <a class="btn" href={url('/about/')}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="2" /><path fill="currentColor" d="M11 10.5h2V17h-2zM11 7h2v2h-2z" /></svg>
          More about us
        </a>
      </div>
    </div>
  </section>

  <div class="rows">
    <section class="row" aria-labelledby="row-services">
      <div class="row-head"><h2 id="row-services">Our services</h2><a href={url('/services/')}>Explore all</a></div>
      <div class="row-body">
        <ul class="track">
          {services.map((s) => (
            <li>
              <a class="tile" href={url(`/services/${s.slug}/`)}>
                <div class="art"><Image src={serviceArt[s.slug as keyof typeof serviceArt]} alt="" widths={[400, 700]} sizes="20rem" /><span class="title">{s.title}</span></div>
                <div class="details"><p>{s.summary}</p><p class="tags">{s.points.slice(0, 3).join(', ')}</p></div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="row" aria-labelledby="row-steps">
      <div class="row-head"><h2 id="row-steps">Procurement, step by step</h2><a href={url(`/services/${procurement.slug}/`)}>How it works</a></div>
      <div class="row-body">
        <ol class="track steps-row">
          {procurement.points.map((p, i) => (
            <li>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <div class="step-card"><Image src={stepArt[i]} alt="" widths={[300]} sizes="9rem" /><span>{p}</span></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="row" aria-labelledby="row-partners">
      <div class="row-head"><h2 id="row-partners">Partners in the region</h2><a href={url('/partners/')}>See all</a></div>
      <div class="row-body">
        <ul class="track">
          {partners.map((name) => (
            <li><a class="tile text" href={url('/partners/')}><div class="art"><span class="name">{name}</span></div></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="row" aria-labelledby="row-insights">
      <div class="row-head"><h2 id="row-insights">New notes from the field</h2><a href={url('/insights/')}>All notes</a></div>
      <div class="row-body">
        <ul class="track">
          {posts.map((post, i) => (
            <li>
              <a class="tile" href={url(`/insights/${post.id}/`)}>
                <div class="art"><Image src={postArt[i % postArt.length]} alt="" widths={[400, 700]} sizes="20rem" /><span class="badge-n">New</span><span class="title">{post.data.title}</span></div>
                <div class="details"><p>{post.data.description}</p><p class="tags">{fmt(post.data.pubDate)}{post.data.market && `, ${post.data.market}`}</p></div>
              </a>
            </li>
          ))}
          <li>
            <a class="tile" href={url('/contact/')}>
              <div class="art"><Image src={trio} alt="" widths={[400, 700]} sizes="20rem" style="object-position: 50% 78%;" /><span class="title">Your product next?</span></div>
              <div class="details"><p>Tell us the product, the target country and the timeline. We reply with specifics.</p><p class="tags">Contact</p></div>
            </a>
          </li>
        </ul>
      </div>
    </section>
  </div>

  <script>
    // Add previous / next buttons to each row; the track itself still scrolls by touch, trackpad and Tab.
    for (const body of document.querySelectorAll<HTMLElement>('.row-body')) {
      const track = body.querySelector<HTMLElement>('.track')!;
      const make = (dir: 'prev' | 'next') => {
        const b = document.createElement('button');
        b.className = `scroll-btn ${dir}`;
        b.type = 'button';
        b.setAttribute('aria-label', dir === 'prev' ? 'Scroll row left' : 'Scroll row right');
        b.textContent = dir === 'prev' ? '‹' : '›';
        b.addEventListener('click', () => track.scrollBy({ left: (dir === 'prev' ? -1 : 1) * track.clientWidth * 0.85, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' }));
        body.append(b);
        return b;
      };
      const prev = make('prev');
      const next = make('next');
      const update = () => {
        prev.disabled = track.scrollLeft < 8;
        next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
      };
      track.addEventListener('scroll', update, { passive: true });
      addEventListener('resize', update);
      update();
    }
  </script>
</Base>
